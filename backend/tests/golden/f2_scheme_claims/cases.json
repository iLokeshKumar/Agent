         "base_value": 800000},
        {"serial": "SN2", "sku_ref": "SAMS-QA65", "status": "in_stock",
         "sold_invoice_ref": null, "sale_date": null, "base_value": 0},
        {"serial": "SN3", "sku_ref": "SAMS-QA77", "status": "sold",
