      "status": "VALIDATION_ERROR"
    }
  },
  {
    "name": "record_claim_positive",
    "payload": {
      "action": "record_claim",
      "scheme_id": "SCH-2026-08",
      "amount_claimed": 44000,
      "amount_computed": 44000
    },
    "expect": {
      "status": "SUCCESS",
      "output.contains": ["amount_claimed", "recorded_ts"]
