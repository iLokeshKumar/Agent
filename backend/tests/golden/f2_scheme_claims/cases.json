[
  {
    "name": "slab2_basic_computation",
    "payload": {
      "action": "compute",
      "scheme_id": "SCH-2026-08",
      "window": {"start": "2026-08-01", "end": "2026-08-31"},
      "eligible_skus": ["SAMS-QA65"],
      "serials": [
        {"serial": "SN1", "sku_ref": "SAMS-QA65", "status": "sold",
