[TEMPLATE]
APP_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yexis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Internal gateway -> backend task API authentication. Generate a strong token
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_API_TOKEN=
# Must be an enabled platform user authorized to submit tasks. Defaults to
# ADMIN_USERNAME when empty; use a dedicated least-privilege user when possible.
GATEWAY_SERVICE_USERNAME=

DATABASE_URL=

# Zoho Books API (https://www.zoho.com/books/api/v3/)
# 1. Go to https://api-console.zoho.com/ and register a client
# 2. Set scopes: ZohoBooks.journals.READ, ZohoBooks.invoices.READ, etc.
# 3. Complete OAuth flow to get refresh_token
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_ORG_ID=
# Encrypts per-user Zoho refresh tokens in the database. Keep stable across
# restarts/backups; changing it makes existing personal connections unreadable.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZOHO_TOKEN_ENCRYPTION_KEY=
ZOHO_DATA_CENTER=in  # us, eu, in, com.au, jp
ZOHO_REDIRECT_URI=http://127.0.0.1:8000/auth/zoho/callback
# Optional shared Zoho MCP tool servers (still admin-managed).
ZOHO_MCP_SERVER_URL_YEXIS=
ZOHO_MCP_SERVER_URL_AGENT=

# Zoho MCP connector OAuth — the MCP servers reject the REST token above (401);
# they need a token issued to a client registered in the Zoho MCP admin console.
# Fill these from that registration, then visit /auth/zoho-mcp/start once.
# authorize_url looks like https://mcp.zoho.in/mcp-client/<hash>/<connector>/oauth
# scopes: the CRM READ scopes + ZohoMCP.tool.execute (space-separated)
# resource: the MCP message URL the token is bound to (the CRM/YE server URL)
ZOHO_MCP_CLIENT_ID=
ZOHO_MCP_CLIENT_SECRET=
ZOHO_MCP_AUTHORIZE_URL=
ZOHO_MCP_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_MCP_REDIRECT_URI=http://127.0.0.1:8000/auth/zoho-mcp/callback
ZOHO_MCP_SCOPES=
ZOHO_MCP_RESOURCE=
# Prefer Zoho MCP for campaign audience records, falling back to Zoho REST
# when a server does not expose the required read tool or a tool call fails.
K2_ZOHO_MCP_ENABLED=true

# Zoho Data Sync (background job)
ZOHO_SYNC_ENABLED=false
ZOHO_SYNC_INTERVAL=900  # seconds (15 min default)

# Tally Prime XML-over-HTTP (see docs/tally-network-setup.md)
TALLY_HOST=
TALLY_PORT=9000
TALLY_COMPANY=Yexis Electronics Pvt Ltd

# ── WhatsApp: pick ONE option ────────────────────────────────────────────────
#
# OPTION A — WABA API (recommended for production)
#   Sign up at gallabox.com or gupshup.io, fill all four values below.
#   Agents send via the real BSP; no browser needed.
WABA_PROVIDER=               # gallabox | gupshup | twilio | meta
WABA_API_KEY=
WABA_API_URL=
WABA_PHONE_NUMBER_ID=
#
# OPTION B — WhatsApp Web via Playwright (no BSP account needed, dev/pilot only)
#   Set WA_WEB_ENABLED=true, then run: python -m mcp.whatsapp_web.server
#   Open http://localhost:8002/qr and scan QR with your phone once.
#   WARNING: against WhatsApp ToS; account may be banned. Use for internal pilots only.
WA_WEB_ENABLED=false
WA_WEB_URL=http://localhost:8002
#
# ─────────────────────────────────────────────────────────────────────────────

# Hosted mailbox (POP3 receive; SMTP send only after approval)
POP3_HOST=
POP3_PORT=995
POP3_USERNAME=
POP3_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_SEND_ENABLED=false
# Randomized pause (seconds) after each K3 campaign email send.
SMTP_SEND_DELAY_MIN_SECONDS=20
SMTP_SEND_DELAY_MAX_SECONDS=75
# Max campaign emails sent per 5-min scheduler tick — this is what makes
# sending trickle across the day instead of bursting a whole audience.
K3_EMAIL_TRICKLE_BATCH_SIZE=5
# Only send campaign email inside this IST hour window.
K3_EMAIL_SEND_WINDOW_START_HOUR=9
K3_EMAIL_SEND_WINDOW_END_HOUR=20
# Campaign intelligence — hot leads to Zoho CRM, engagement scoring, A/B winner
# (Zoho refresh token needs ZohoCRM.modules.ALL or Tasks/Leads/Contacts create+read)
K3_CRM_ESCALATION_ENABLED=true
K3_CRM_TASK_OWNER_ID=
K3_HOT_SCORE_THRESHOLD=5
K3_COLD_STOP_AFTER_EMAILS=3
K3_AB_MIN_PER_VARIANT=10
K3_AB_DECIDE_AFTER_HOURS=24
K3_AB_TEST_FRACTION=0.2
# ISM Campaign Assistant
ISM_DEFAULT_VERTICALS=Education,Government,PSU
ISM_DEFAULT_REGIONS=Tamil Nadu
ISM_TIER_FIT_THRESHOLD=70
ISM_TIER_INTENT_THRESHOLD=40
ISM_CALLS_PER_ISR_PER_DAY=25
K3_MAX_TOUCHES_PER_WEEK=2
ISM_DEFAULT_OWNER=
ISM_PRESALES_OWNER=
ISM_MANAGER_EMAIL=
# Gateway: mailbox poll interval in seconds (spec: replies classified within 60 s)
MAIL_POLL_SECONDS=60

# Public base URL — baked into every campaign email's click-tracking,
# open-pixel, unsubscribe and pre-filled-form links.
#
# MUST be a STABLE public hostname. If it changes, those links in
# already-sent mail stop working. Do NOT use a Cloudflare *quick* tunnel
# (https://<random-words>.trycloudflare.com) here: it gets a new random
# hostname on every restart, which silently breaks the links in mail you
# already sent. The app logs a startup warning if it detects one.
#
# Recommended: a Cloudflare NAMED tunnel bound to your own domain, e.g.
#   1. cloudflared tunnel login
#   2. cloudflared tunnel create yexis
#   3. map a DNS route:  cloudflared tunnel route dns yexis track.yexiselectronics.com
#   4. run it pointing at the app:
#        cloudflared tunnel run --url http://127.0.0.1:8000 yexis
#   5. set APPROVAL_BASE_URL=https://track.yexiselectronics.com
# The named tunnel's hostname is fixed, so every link keeps working.
APPROVAL_BASE_URL=https://track.yexiselectronics.com

# Enrichment
APOLLO_API_KEY=
ROCKETREACH_API_KEY=

# Other shared provider connections (admin-managed)
TELEGRAM_BOT_TOKEN=
VOICE_PROVIDER=                 # exotel | twilio | ozonetel
VOICE_API_KEY=
VOICE_API_URL=
VOICE_CALLER_ID=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=       # base64-encoded service-account JSON
# Legacy FCM credential; prefer a service account.
FCM_SERVER_KEY=

# Cloud analytics store (yexis_agent_cloud) — target of the nightly
# Local→Cloud shipper and home of the read-only cloud_db MCP tools.
# Empty = shipper skips, /mcp/cloud_db/* returns 503.
CLOUD_DATABASE_URL=

# Nightly analytics chain (marts → KPIs → cloud ship → DPDP purge)
NIGHTLY_ANALYTICS_ENABLED=true
NIGHTLY_ANALYTICS_HOUR=2

# Optional provider-neutral model runtime (disabled unless explicitly enabled).
# OpenAI/Mistral/Ollama/vLLM: MODEL_PROVIDER=openai_compatible
# Anthropic: MODEL_PROVIDER=anthropic
MODEL_PROVIDER=disabled
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
# Optional K1 draft-only shadow; only enable after reviewing provider data terms.
K1_MODEL_SHADOW_ENABLED=false
