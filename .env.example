# Copy to .env and set a unique, randomly generated value before using Docker.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_DB=yexis
# Bootstrap administrator; backend/gateway use the separate non-superuser role.
POSTGRES_USER=yexis_admin
POSTGRES_PASSWORD=
POSTGRES_APP_USER=yexis_app
POSTGRES_APP_PASSWORD=
